# Octomus Docker deployment settings. ./setup.sh copies this file to .env and fills in what it can.
# Everything here is host-owned: the dashboard can show these values but never change them.

# The one repository Octomus improves. The control plane clones it into its data volume on first start.
OCTOMUS_GITHUB_REPO=OWNER/REPOSITORY

# Group owning /var/run/docker.sock, so only the sandbox broker can use it. setup.sh detects it.
DOCKER_GID=

# Dashboard port, published on 127.0.0.1 only. Reach it through: ssh -N -L 4200:127.0.0.1:<this port> your-vps
OCTOMUS_PORT=4200

# Images. setup.sh builds both locally; release images can be used instead. To add a toolchain, point
# OCTOMUS_SANDBOX_IMAGE at an image built FROM octomus-sandbox:local (docs/sandbox.md).
OCTOMUS_IMAGE=octomus-agent:local
OCTOMUS_SANDBOX_IMAGE=octomus-sandbox:local

# Limits for each sandbox container. At most OCTOMUS_SANDBOX_MAX run at once, so the worst case is
# OCTOMUS_SANDBOX_MAX x OCTOMUS_SANDBOX_MEMORY of RAM. Size these to leave room for everything else on the host.
OCTOMUS_SANDBOX_CPUS=2
OCTOMUS_SANDBOX_MEMORY=4g
OCTOMUS_SANDBOX_PIDS=1024
OCTOMUS_SANDBOX_TMPFS=1g
OCTOMUS_SANDBOX_MAX=12
# Stronger kernel isolation with gVisor, once runsc is installed and registered with Docker:
# OCTOMUS_SANDBOX_RUNTIME=runsc

# Egress allowlists: comma-separated host names or *.suffix, with an optional :port (default 443).
# Model hosts are reachable only from agent sessions and runner logins; build hosts also from verification.
# An empty value allows no host.
# Codex (ChatGPT sign-in or API key):
OCTOMUS_EGRESS_MODEL_HOSTS=chatgpt.com,auth.openai.com,api.openai.com
# OpenCode adds its model catalog, models.opencode.ai, and your providers, for example api.anthropic.com or
# openrouter.ai. Runners also try update checks against GitHub; the gateway refuses and logs them.
#
# Package registries your agents and verification commands need. Every allowed host is a possible way out for data,
# so list only what the project uses. Common choices:
#   Go      proxy.golang.org,sum.golang.org
#   npm     registry.npmjs.org
#   PyPI    pypi.org,files.pythonhosted.org
#   Rust    index.crates.io,static.crates.io
OCTOMUS_EGRESS_BUILD_HOSTS=
